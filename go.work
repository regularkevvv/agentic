go 1.25.4

// All pure-Go modules in the repository. provider/local/onnx and
// e2e/localinference are deliberately absent: they need CGO, a native ONNX
// Runtime, and a statically linked tokenizer, and adding them here would make
// `go build ./...` at the repository root fail for everyone who has not
// installed those. They are built and linted by the `onnx` CI job instead, and
// TestWorkspaceListsEveryNonCGOModule in architecture_test.go fails if this
// list drifts from that rule in either direction. See ARCHITECTURE.md.
use (
	.
	./e2e
	./harness
	./harness/codemode/gomonty
	./harness/sessionloop
	./otel
	./provider/anthropic
	./provider/azure
	./provider/bedrock
	./provider/cohere
	./provider/deepinfra
	./provider/endpoint
	./provider/gemini
	./provider/grok
	./provider/huggingface
	./provider/ollama
	./provider/openai
	./provider/openrouter
	./provider/pinecone
	./provider/sagemaker
	./provider/together
	./provider/voyageai
	./tui
)
