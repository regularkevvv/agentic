set default-list
set lazy
set minimum-version := "1.58.0"
set shell := ["bash", "-euo", "pipefail", "-c"]

golangci_lint_version := "v2.1.6"
coverage_threshold := "97.0"
coverage_packages := `go list ./... | grep -vE '/(artifacttest|envtest|eventtest|memorytest|storetest)($|/)' | tr '\n' ' '`

# Run race-enabled tests.
[group("test")]
test:
    go test -race -count=1 -timeout 60s ./...

# Measure coverage, excluding reusable test helpers.
[group("coverage")]
coverage:
    go test -count=1 -coverprofile=coverage.out {{ coverage_packages }}
    @go tool cover -func=coverage.out | tail -n 1

# Enforce the module's minimum coverage.
[group("coverage")]
coverage-check: coverage
    #!/usr/bin/env bash
    set -euo pipefail
    pct="$(go tool cover -func=coverage.out | awk '/^total:/ { gsub(/%/, "", $3); print $3 }')"
    awk -v pct="$pct" -v threshold="{{ coverage_threshold }}" 'BEGIN {
      if ((pct + 0) < (threshold + 0)) {
        printf("coverage %.1f%% is below required %.1f%%\n", pct + 0, threshold + 0)
        exit 1
      }
      printf("coverage %.1f%% meets required %.1f%%\n", pct + 0, threshold + 0)
    }'

# Run golangci-lint.
[group("quality")]
lint:
    go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@{{ golangci_lint_version }} run ./...

# Run go vet.
[group("quality")]
vet:
    go vet ./...

# Build all packages.
[group("quality")]
build:
    go build ./...

# Format Go source with gofmt and goimports.
[group("quality")]
fmt:
    gofmt -w .
    go run golang.org/x/tools/cmd/goimports@latest -w -local github.com/regularkevvv/agentic/harness .

# Run formatting, vet, lint, and race-enabled tests.
[group("quality")]
check: fmt vet lint test

# Remove coverage artifacts and the Go test cache.
[group("maintenance")]
clean:
    rm -f coverage.out
    go clean -testcache
