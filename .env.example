# Required for examples (pick at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider keys
GEMINI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

# Retrieval: multi-representation encoders (dense + learned sparse + ColBERT)
DEEPINFRA_TOKEN=
HF_TOKEN=

# Hugging Face shared router (dense only). Set a model to enable its e2e test.
HF_SHARED_MODEL=

# Any endpoint you operate that runs deploy/representations/handler.py —
# Hugging Face, SageMaker, Kubernetes, a machine under a desk. provider/endpoint
# speaks the protocol; it reads no vendor's variable, so the token is its own.
# The expected space ID is required: a live test that accepted whatever the
# endpoint reported would pass against a redeployment onto different weights.
AGENTIC_ENDPOINT_TOKEN=
HF_ENDPOINT_URL=
HF_DENSE_SPACE_ID=

# A handler served locally by deploy/representations/serve_local.py, which needs
# no token at all — the encoder is built with endpoint.WithoutAuthentication().
AGENTIC_LOCAL_HANDLER_URL=

# In-process encoding via provider/onnx, a nested module that is not built
# unless you ask for it. Both paths are local files: nothing downloads a model
# at runtime. See provider/onnx/README.md for producing the graph.
AGENTIC_ONNX_MODEL=
AGENTIC_ONNX_TOKENIZER=
AGENTIC_ONNX_LIBRARY=

# SageMaker endpoint running the same handler (uses the default AWS
# credential chain, plus AWS_REGION).
SAGEMAKER_ENDPOINT=
SAGEMAKER_DENSE_SPACE_ID=

# Pinecone standalone Inference (encoding only; index APIs are out of scope).
PINECONE_API_KEY=
PINECONE_SPARSE_MODEL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# AWS Bedrock (uses default credential chain)
# AWS_REGION=us-east-1
