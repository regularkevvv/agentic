# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# `go build ./...` writes one executable per main package into the directory it
# is run from, named after the package. Those names have no extension, so none
# of the rules above match them, and a 26 MiB Mach-O binary was committed that
# way once. These are every main package in the two example modules.
/e2e/basic
/e2e/retrieval
/e2e/sparse
/e2e/structured
/e2e/tools
/e2e/localinference/sparse

# Output of the go coverage tool
*.out
*.coverprofile

# Go workspace checksum (go.work is committed for the root and harness modules)
go.work.sum

# Dependency directories
vendor/

# IDE / editor
.claude/
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Python bytecode from the representation handler contract tests
__pycache__/
*.pyc

# Exported model graphs and the native libraries provider/local/onnx links against.
# The Granite export alone is 117 MiB; none of this belongs in git, and
# provider/local/onnx/README.md says where each piece comes from instead.
*.onnx
provider/local/onnx/lib/
provider/local/onnx/onnxruntime-*/
